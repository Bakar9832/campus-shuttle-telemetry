POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_DB=telemetry
DATABASE_URL=postgres://telemetry:telemetry@timescale:5432/telemetry
MQTT_URL=mqtt://mosquitto:1883
FLEET_SIZE=1
TICK_MS=1000
API_PORT=3000

# Fault injection (slice 2). These are the defaults; raise DROPOUT_CHANCE to
# around 0.5 to watch outages, buffered replay and redelivery in real time.
DROPOUT_CHANCE=0.001
DROPOUT_MIN_SEC=30
DROPOUT_MAX_SEC=180
MAX_BUFFER=3600
REPLAY_SHUFFLE=true
DUPLICATE_CHANCE=0.02
